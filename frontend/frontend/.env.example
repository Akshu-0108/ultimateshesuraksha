# Leave unset for local development (defaults to http://localhost:5000/api).
# Set this to the deployed backend URL in production, without a trailing slash.
VITE_API_BASE_URL=https://your-api.example.com/api

# Optional: enables three-character place suggestions and accurate walking-route geometry on Safety Map.
# Create a free key at https://openrouteservice.org/dev/#/signup and never commit the real key.
VITE_ORS_API_KEY=your_openrouteservice_key
