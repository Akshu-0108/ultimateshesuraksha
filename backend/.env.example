# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git — it's already in .gitignore.

# MongoDB Atlas connection string
# Get this from Atlas: Database > Connect > Drivers > copy the URI
# Replace <username>, <password>, and <dbname> in the string.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shesuraksha?retryWrites=true&w=majority

# Port the server runs on locally
PORT=5000

# Secret used to sign JWT auth tokens — use any long random string.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Your frontend's local dev URL (Vite default), used for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional Python service that loads shesuraksha_model.pkl for the Area Audit.
# Start it with: python -m uvicorn app:app --port 8000 (from backend/)
ML_SERVICE_URL=http://127.0.0.1:8000
